# Copy this file to .env.local for local development. Never commit local env files.

GRADPATH_ENVIRONMENT=local
GRADPATH_ENABLE_API_DOCS=true
GRADPATH_CORS_ORIGINS=["http://localhost:5173"]
GRADPATH_DATABASE_URL=postgresql+psycopg://gradpath:gradpath_dev@localhost:5432/gradpath
GRADPATH_OPENAI_MODEL=gpt-5.6-sol
GRADPATH_OPENAI_REASONING_EFFORT=medium
GRADPATH_OPENAI_STORE_RESPONSES=false
GRADPATH_AGENT_TRACING_ENABLED=false
GRADPATH_AGENT_MAX_TURNS=4
GRADPATH_WORKFLOW_MAX_RETRIES=2
GRADPATH_WORKFLOW_MAX_CLARIFICATION_ROUNDS=1
GRADPATH_EMBEDDING_MODEL=text-embedding-3-small
GRADPATH_EMBEDDING_DIMENSIONS=1536
GRADPATH_EMBEDDING_BATCH_SIZE=32
GRADPATH_RETRIEVAL_LIMIT=3
GRADPATH_RETRIEVAL_CANDIDATE_LIMIT=8
GRADPATH_RETRIEVAL_RRF_K=60

# Add OPENAI_API_KEY only to your ignored .env.local file. Never place a real
# secret in this tracked example. Object-storage and identity-provider settings
# will be added only when their adapters are implemented.
