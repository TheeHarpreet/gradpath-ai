# Copy this file to .env for local development. Never commit .env.

GRADPATH_ENVIRONMENT=local
GRADPATH_ENABLE_API_DOCS=true
GRADPATH_CORS_ORIGINS=["http://localhost:5173"]
GRADPATH_DATABASE_URL=postgresql+psycopg://gradpath:gradpath_dev@localhost:5432/gradpath

