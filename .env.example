# Copy this file to .env.local for local development. Never commit local env files.

GRADPATH_ENVIRONMENT=local
GRADPATH_ENABLE_API_DOCS=true
GRADPATH_CORS_ORIGINS=["http://localhost:5173"]
GRADPATH_DATABASE_URL=postgresql+psycopg://gradpath:gradpath_dev@localhost:5432/gradpath
GRADPATH_OPENAI_MODEL=gpt-5.6-sol
GRADPATH_OPENAI_REASONING_EFFORT=medium
GRADPATH_OPENAI_STORE_RESPONSES=false

# Add OPENAI_API_KEY only to your ignored .env.local file. Never place a real
# secret in this tracked example. Embedding, object-storage and identity-provider
# settings will be added only when their adapters are implemented.
